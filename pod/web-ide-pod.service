# User service of the pod (make service): starts with the session, restarts on failure.
[Unit]
Description=Web IDE pod
After=network.target

[Service]
ExecStart=%h/.local/bin/web-ide-pod
# Language servers and tools installed by the user (go install, npm -g, pipx…).
Environment=PATH=%h/.local/bin:%h/go/bin:%h/.npm-global/bin:/usr/local/go/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
