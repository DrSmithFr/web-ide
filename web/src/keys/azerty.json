{
  "name": "AZERTY",
  "labels": {
    "KeyQ": "A",
    "KeyW": "Z",
    "KeyA": "Q",
    "KeyZ": "W",
    "Semicolon": "M",
    "KeyM": ",",
    "Comma": ";",
    "Period": ":",
    "Slash": "!",
    "Backquote": "²",
    "Minus": ")",
    "Equal": "=",
    "BracketLeft": "^",
    "BracketRight": "$",
    "Quote": "ù",
    "Backslash": "*",
    "IntlBackslash": "<",
    "Digit1": "&",
    "Digit2": "é",
    "Digit3": "\"",
    "Digit4": "'",
    "Digit5": "(",
    "Digit6": "-",
    "Digit7": "è",
    "Digit8": "_",
    "Digit9": "ç",
    "Digit0": "à"
  },
  "bindings": {
    "file.save": [
      "Ctrl+KeyS"
    ],
    "file.saveAll": [
      "Ctrl+Shift+KeyS"
    ],
    "edit.undo": [
      "Ctrl+KeyW"
    ],
    "edit.redo": [
      "Ctrl+Shift+KeyW"
    ],
    "edit.duplicateLine": [
      "Ctrl+KeyD"
    ],
    "edit.deleteLine": [
      "Ctrl+KeyY"
    ],
    "edit.toggleComment": [
      "Ctrl+Shift+Period"
    ],
    "edit.selectAll": [
      "Ctrl+KeyQ"
    ],
    "edit.nextOccurrence": [
      "Alt+KeyJ"
    ],
    "edit.unselectOccurrence": [
      "Alt+Shift+KeyJ"
    ],
    "edit.allOccurrences": [
